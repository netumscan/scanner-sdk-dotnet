<Window x:Class="ScannerSDK.WPFDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScannerSDK.WPFDemo"
        Title="{Binding AppTitle}"
        Height="820"
        Width="1360"
        MinHeight="640"
        MinWidth="1040"
        Background="#FFF4F7FB">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="BrandBrush" Color="#FF0F6CBD" />
        <SolidColorBrush x:Key="BrandSoftBrush" Color="#FFE7F1FB" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFC0342B" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFDECEC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD7DEE7" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF17212B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5B6776" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF778395" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource MutedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionCaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="ConsoleInfoTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="20,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding AppTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding AppSubtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Margin="0,6,0,0"
                            Padding="7,2"
                            HorizontalAlignment="Left"
                            Background="{StaticResource DangerSoftBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsFakeMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FakeModeBannerText}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="{Binding NavDiscoveryText}" Command="{Binding OpenDiscoveryCommand}" />
                    <Button Style="{StaticResource NavButton}" Content="{Binding NavConsoleText}" Command="{Binding OpenConsoleCommand}" />
                    <Button Style="{StaticResource NavButton}" Content="{Binding NavLogsText}" Command="{Binding OpenLogsCommand}" />
                    <Button x:Name="SettingsButton"
                            Margin="0,0,0,8"
                            Click="SettingsButton_Click"
                            ToolTip="{Binding SettingsLabelText}"
                            AutomationProperties.Name="{Binding SettingsLabelText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SettingsLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         VerticalOffset="4"
                                         MinWidth="190"
                                         HasDropShadow="True"
                                         StaysOpen="False" />
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1"
                    Margin="14"
                    SelectedIndex="{Binding SelectedWorkspaceIndex}">
            <TabItem Header="{Binding TabDiscoveryText}">
                <local:DiscoveryView Margin="0,10,0,0" />
            </TabItem>
            <TabItem Header="{Binding TabConsoleText}">
                <local:ConsoleView Margin="0,10,0,0" />
            </TabItem>
            <TabItem Header="{Binding TabLogsText}">
                <local:LogsView x:Name="LogsWorkspace" Margin="0,10,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
