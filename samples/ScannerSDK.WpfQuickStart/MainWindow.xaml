<Window x:Class="ScannerSDK.WpfQuickStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner SDK Quick Start"
        Width="1180"
        Height="780"
        MinWidth="720"
        MinHeight="600"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        Foreground="#172033">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="LineBrush" Color="#D9E1EC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8EEF8" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Text="Scanner SDK Quick Start" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Windows x64 · USB CDC · WPF / .NET 10" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Status}" />
                    <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding SdkVersion, StringFormat=SDK {0}}" />
                    <ProgressBar Width="160" Height="3" Margin="0,8,0,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="DiscoveryPanel" Padding="22" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Find a scanner" />
                        <TextBlock Margin="0,5,0,18" Style="{StaticResource Caption}" Text="Choose a model, then refresh scanners connected in USB CDC mode." TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Caption}" Text="MODEL" />
                        <ComboBox MinHeight="36" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName" />
                        <Button Margin="0,12,0,18" Command="{Binding RefreshDevicesCommand}" Content="{Binding RefreshButtonText}" />
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Available devices" />
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource Caption}" Text="No matching devices found."
                                   Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ListBox x:Name="DeviceList" MinHeight="170" ItemsSource="{Binding Devices}" BorderBrush="{StaticResource LineBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding ModelSummary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Margin="0,12,0,0" Command="{Binding ConnectCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeviceList}" Content="Connect" />
                    </StackPanel>
                </Border>

                <Border x:Name="SessionPanel" Grid.Column="2" Padding="24" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Session" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Actions are enabled only when the ready session reports support." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding DisconnectCommand}" Content="Disconnect" />
                        </Grid>

                        <Grid Margin="0,22,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="CONNECTED DEVICE" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding ConnectedDeviceName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="RESOLVED MODEL" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding ResolvedModel}" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource LineBrush}" />
                        <TextBlock Margin="0,18,0,10" FontWeight="SemiBold" Text="Quick actions" />
                        <WrapPanel>
                            <Button Margin="0,0,10,10" Command="{Binding TriggerScanCommand}" Content="Trigger Scan" />
                            <Button Margin="0,0,10,10" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshInfoCommand}" Content="Refresh Device Info" />
                            <Button Margin="0,0,0,10" Style="{StaticResource SecondaryButton}" Command="{Binding ReadBatteryCommand}" Content="Read Battery" />
                        </WrapPanel>
                        <TextBlock Margin="0,2,0,16" Style="{StaticResource Caption}" Text="{Binding LastAction}" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Device info" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="{Binding DeviceInfo}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="Battery" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="{Binding Battery}" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource LineBrush}" />
                        <Grid Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Recent scans" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Latest 20 · memory only" />
                        </Grid>
                        <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="No scans received."
                                   Visibility="{Binding HasNoScans, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Scans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Summary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
